# Production report server behind https://algoray.tech/koyson-zoho/acc-reports/
# Apache proxies that prefix to 127.0.0.1:8765 (see algoray.tech-le-ssl.conf).
# Worktree code, database zoho-koyson (.env). Zoho web-tab JWT is required (.env.mis).
# Do not set MIS_AUTH_DISABLED or an empty MIS_JWT_SECRET: either one turns the token check off.
[Unit]
Description=Koyson Zoho MIS reports web (zoho-koyson DB, port 8765, web-tab JWT)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nellon/nellon_vansales/.claude/worktrees/mis-date-range/reports/mis
ExecStart=/home/nellon/nellon_vansales/.claude/worktrees/mis-date-range/reports/mis/.venv/bin/python -m backend serve --host 127.0.0.1 --port 8765
Environment=PYTHONUNBUFFERED=1
Environment=MIS_LIVE_FINANCIALS=1
EnvironmentFile=/home/nellon/nellon_vansales/.env_zoho
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
