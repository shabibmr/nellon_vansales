// ============================================================
// Zoho Books - Actual COGS & Line Items Synchronization
// ============================================================
// 1. Only posted invoices are processed (status from the function param).
// 2. Journal Cost of Sales is checked first; if none exists, nothing is updated.
//    cf_actual_cogs comes from the invoice journal.
// 3. cf_line_cogs_document comes from GET /invoices/{id}.
//    Line COGS = quantity x conversion_rate x purchase_price (cost is per base unit).
// ------------------------------------------------------------
// Configuration
// ------------------------------------------------------------
organization_id = organization.get("organization_id");
invoice_id = invoice.get("invoice_id");
cogs_field_id = "3331482000187193020";
// Actual COGS (Decimal)
cogs_doc_field_id = "3331482000188147019";
// Line COGS Document (Multiline JSON)
// ------------------------------------------------------------
// 1. Status gate (allow-list, from the function param)
// ------------------------------------------------------------
invoice_status = ifnull(invoice.get("status"),"").toString().toLowerCase();
posted_statuses = {"sent","paid","partially_paid","overdue","unpaid","viewed","approved"};
if(!posted_statuses.contains(invoice_status))
{
	info "Invoice " + invoice_id + " status '" + invoice_status + "' not posted. No update.";
	return;
}
// ------------------------------------------------------------
// 2. Journal -> cf_actual_cogs (no journal COGS = skip all updates)
// ------------------------------------------------------------
journal_url = "https://www.zohoapis.com/books/v3/transactions/" + invoice_id + "/journals?organization_id=" + organization_id + "&entity_type=invoice";
journal_response = invokeurl
[
	url :journal_url
	type :GET
	connection:"zbooksdeluge"
];
if(journal_response.get("code") != 0)
{
	info "Journal GET failed for " + invoice_id + ": " + journal_response.get("message");
	return;
}
actual_cogs = 0.0;
journals = journal_response.get("journals");
if(journals != null)
{
	for each  journal in journals
	{
		transaction_details = journal.get("transaction_details");
		if(transaction_details != null)
		{
			for each  jline in transaction_details
			{
				account_name = ifnull(jline.get("account_name"),"");
				debit_amount = ifnull(jline.get("bcy_debit_amount"),0).toDecimal();
				if(account_name.contains("Cost of Sales") && debit_amount > 0)
				{
					actual_cogs = actual_cogs + debit_amount;
				}
			}
		}
	}
}
actual_cogs = actual_cogs.round(2);
if(actual_cogs <= 0)
{
	info "No journal Cost of Sales for " + invoice_id + ". Skipping all updates.";
	return;
}
// ------------------------------------------------------------
// 3. Invoice detail -> cf_line_cogs_document
// ------------------------------------------------------------
inv_resp = invokeurl
[
	url :"https://www.zohoapis.com/books/v3/invoices/" + invoice_id + "?organization_id=" + organization_id
	type :GET
	connection:"zbooksdeluge"
];
if(inv_resp.get("code") != 0 || inv_resp.get("invoice") == null)
{
	info "Invoice GET failed for " + invoice_id + ": " + inv_resp.get("message");
	return;
}
full_invoice = inv_resp.get("invoice");
lines_list = List();
goods_lines = 0;
goods_missing_cost = 0;
for each  line in ifnull(full_invoice.get("line_items"),List())
{
	qty = ifnull(line.get("quantity"),0).toDecimal();
	val_cost = ifnull(line.get("purchase_price"),0).toDecimal();
	conv = ifnull(line.get("conversion_rate"),1).toDecimal();
	if(conv <= 0)
	{
		conv = 1;
	}
	base_qty = qty * conv;
	item_cogs = (base_qty * val_cost).round(2);
	item_map = Map();
	item_map.put("item_id",ifnull(line.get("item_id"),""));
	item_map.put("name",ifnull(line.get("name"),""));
	item_map.put("sku",ifnull(line.get("sku"),""));
	item_map.put("qty",qty);
	item_map.put("unit",ifnull(line.get("unit"),""));
	item_map.put("conversion_rate",conv);
	item_map.put("base_qty",base_qty);
	item_map.put("rate",ifnull(line.get("rate"),0).toDecimal());
	item_map.put("cost",val_cost);
	item_map.put("cogs",item_cogs);
	if(ifnull(line.get("product_type"),"").toString().toLowerCase() == "goods")
	{
		goods_lines = goods_lines + 1;
		if(val_cost <= 0)
		{
			goods_missing_cost = goods_missing_cost + 1;
			item_map.put("cost_missing",true);
			info "Missing purchase_price on line '" + line.get("name") + "' of " + invoice_id;
		}
	}
	lines_list.add(item_map);
}
new_cogs_doc = "[" + lines_list.toString() + "]";
// Every goods line lacks a cost: do not store zeros as if booked
skip_doc = goods_lines > 0 && goods_missing_cost == goods_lines;
// ------------------------------------------------------------
// 4. Write both fields when either value changed
// ------------------------------------------------------------
existing_cogs = 0.0;
existing_doc = "";
invoice_custom_fields = full_invoice.get("custom_fields");
if(invoice_custom_fields != null)
{
	for each  field in invoice_custom_fields
	{
		fid = field.get("customfield_id");
		fval = ifnull(field.get("value"),"");
		if(fid == cogs_field_id && fval != "")
		{
			existing_cogs = fval.toDecimal().round(2);
		}
		if(fid == cogs_doc_field_id)
		{
			existing_doc = fval.toString();
		}
	}
}
info "Invoice ID: " + invoice_id;
info "Actual COGS: " + actual_cogs + " (Existing: " + existing_cogs + ")";
info "Lines Count: " + lines_list.size();
if(skip_doc)
{
	info "All goods lines lack purchase_price for " + invoice_id + ". Line document not written.";
	new_cogs_doc = existing_doc;
}
if(existing_cogs != actual_cogs || existing_doc.trim() != new_cogs_doc.trim())
{
	updated_fields = List();
	if(invoice_custom_fields != null)
	{
		for each  f in invoice_custom_fields
		{
			fid = f.get("customfield_id");
			if(fid != cogs_field_id && fid != cogs_doc_field_id)
			{
				fmap = Map();
				fmap.put("customfield_id",fid);
				fmap.put("value",f.get("value"));
				updated_fields.add(fmap);
			}
		}
	}
	cogs_map = Map();
	cogs_map.put("customfield_id",cogs_field_id);
	cogs_map.put("value",actual_cogs.toString());
	updated_fields.add(cogs_map);
	doc_map = Map();
	doc_map.put("customfield_id",cogs_doc_field_id);
	doc_map.put("value",new_cogs_doc);
	updated_fields.add(doc_map);
	invoice_update = Map();
	invoice_update.put("custom_fields",updated_fields);
	update_response = invokeurl
	[
		url :"https://www.zohoapis.com/books/v3/invoices/" + invoice_id + "?organization_id=" + organization_id
		type :PUT
		parameters:invoice_update.toString()
		headers:{"Content-Type":"application/json"}
		connection:"zbooksdeluge"
	];
	if(update_response.get("code") == 0)
	{
		info "Updated Invoice: COGS=" + actual_cogs + ", Lines=" + lines_list.size();
	}
	else
	{
		info "UPDATE FAILED for " + invoice_id + ": " + update_response.get("message");
	}
}
else
{
	info "COGS and Line Document already up to date. No update required.";
}
